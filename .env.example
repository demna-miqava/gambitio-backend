PORT=8080
POSTGRES_CONNECTION_STRING=postgres://postgres:password@localhost:5432/chess
REDIS_URL=redis://localhost:6379
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Optional but recommended in production: the instance's JWT public key (Clerk dashboard > API keys >
# "JWT public key", the PEM text). Session tokens are then checked locally and never cause a call to Clerk.
# Literal \n escapes instead of line breaks are fine. Without it the signing keys are fetched from Clerk.
CLERK_JWT_KEY=
FRONTEND_URL=http://localhost:5173
# Optional: Postgres pool size and the longest a single query may run
PG_POOL_MAX=15
PG_STATEMENT_TIMEOUT_MS=5000
# Optional, comma-separated: more origins allowed to call the API (e.g. http://192.168.0.10:5173 to test from a phone)
EXTRA_FRONTEND_ORIGINS=
# Optional, local dev only: "true" also allows any private-network origin (192.168.x.x, 10.x.x.x, *.local),
# so the dev server opened from a phone keeps working when the Mac's IP changes. Never set in production.
ALLOW_LAN_ORIGINS=
# Optional: web push notifications (challenges, friend requests, "your game has started").
# Make a key pair with `npm run generate-vapid-keys` and set both, or leave both empty to keep push off.
# VAPID_SUBJECT is a mailto: or https: address a push service can contact; it defaults to FRONTEND_URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
