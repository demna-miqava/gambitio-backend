{
  "name": "gambitio-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"tsx --env-file=.env src/index.ts\"",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "migrate": "tsx --env-file=.env scripts/migrate.ts",
    "generate-vapid-keys": "web-push generate-vapid-keys",
    "import-puzzles": "tsx --env-file=.env scripts/import-lichess-puzzles.ts",
    "reports": "tsx --env-file=.env scripts/reports.ts",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "deploy": "grep -q '^VITE_CLERK_PUBLISHABLE_KEY=pk_live_' ../gambitio-frontend/.env.production || { echo 'Put your Clerk production key (pk_live_...) in gambitio-frontend/.env.production first'; exit 1; }; npm --prefix ../gambitio-frontend run build && wrangler deploy"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@clerk/backend": "^3.27.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/postgres": "^6.0.2",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/websocket": "^11.2.0",
    "chess.js": "^1.4.0",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "redis": "^5.9.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "^5.20261112.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.161.0",
    "ws": "^8.22.2"
  },
  "engines": {
    "node": ">=26"
  }
}
